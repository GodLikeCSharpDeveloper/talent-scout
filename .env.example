# Copy to .env. Real values belong only in .env or deployment environment.
# Docker Compose reads this file; dotnet run does not. See README for User Secrets.

# Required secrets and the API port exposed on the host.
POSTGRES_PASSWORD=
API_KEY=
API_PORT=5262

# LinkedIn / Unipile. Empty keys keep integrations disabled.
LINKEDIN_BASE_URL=
LINKEDIN_API_KEY=
LINKEDIN_ACCOUNT_ID=
LINKEDIN_WEBHOOK_SECRET=
LINKEDIN_WEBHOOK_URL=
LINKEDIN_USE_INMAIL=false

# Enable only after configuring both LinkedIn and AI.
PIPELINE_WORKER_ENABLED=false
PIPELINE_POLL_INTERVAL_SECONDS=30
PIPELINE_BATCH_SIZE=10
PIPELINE_SYNC_INTERVAL_MINUTES=10
PIPELINE_MINIMUM_SEND_INTERVAL_SECONDS=60
PIPELINE_MAXIMUM_DAILY_MESSAGES_PER_CAMPAIGN=50

# OpenAI. Confidence is 0..1, not a percentage.
AI_API_KEY=
AI_MODEL=gpt-4.1-mini
AI_MINIMUM_INTEREST_CONFIDENCE=0.8

# Scheduling.
INTERVIEW_URL=
SCHEDULING_API_KEY=
SCHEDULING_WEBHOOK_SIGNING_KEY=
